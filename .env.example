# Required
DISCORD_TOKEN=
# Use a guild ID for instant slash-command sync while developing. Leave blank for global sync.
GUILD_ID=

# Persistence and limits
DATABASE_PATH=data/luna_gf.sqlite3
MAX_DAILY_DMS=2
RELATIONSHIP_DAILY_CAP=40

# Optional open-ended AI replies. Leave blank to use Luna's context-aware local fallback.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=25

# Discord Voice GF / TTS
# auto = external TTS when configured, then local espeak-ng fallback
# none = disable speaking while keeping voice join/leave commands available
TTS_PROVIDER=auto
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=nova
TTS_TIMEOUT_SECONDS=30
FFMPEG_PATH=ffmpeg
LOCAL_TTS_COMMAND=espeak-ng
# Use a voice installed in espeak-ng. 'en' is the portable default; configure a
# supported Bengali voice on your host if available.
LOCAL_TTS_VOICE=en
VOICE_CACHE_DIR=data/voice_cache
